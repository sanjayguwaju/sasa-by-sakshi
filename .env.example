# ==============================================================================
# Sasa by Sakshi — Complete Environment Configuration Template
# ==============================================================================
# Copy this file to .env.docker for Docker/Coolify deployments, or into individual
# apps (.env.local) for local development.

# ==============================================================================
# 1. DATABASE & INFRASTRUCTURE (PostgreSQL & Redis)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=sasa_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:your_secure_postgres_password@postgres:5432/sasa_db
REDIS_URL=redis://redis:6379

# ==============================================================================
# 2. MEDUSA BACKEND CORE & SECURITY
# ==============================================================================
# Generate strong random strings for secrets (e.g. openssl rand -base64 32)
JWT_SECRET=supersecret_jwt_random_key_change_me
COOKIE_SECRET=supersecret_cookie_random_key_change_me

# CORS Configuration (Comma-separated URLs allowed to access the backend)
# Local: http://localhost:8000,http://localhost:8001,http://localhost:5173
# Production: https://sasabysakshi.com,https://api.sasabysakshi.com
STORE_CORS=https://sasabysakshi.com,https://www.sasabysakshi.com,http://localhost:8000
ADMIN_CORS=https://api.sasabysakshi.com,http://localhost:5173,http://localhost:9000
AUTH_CORS=https://api.sasabysakshi.com,https://sasabysakshi.com,http://localhost:5173,http://localhost:9000,http://localhost:8000

# Admin user auto-created on initial boot
MEDUSA_ADMIN_EMAIL=admin@sasabysakshi.com
MEDUSA_ADMIN_PASSWORD=your_secure_admin_password_here

NODE_ENV=production

# ==============================================================================
# 3. NEXT.JS STOREFRONT SETTINGS
# ==============================================================================
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.sasabysakshi.com
NEXT_PUBLIC_BASE_URL=https://sasabysakshi.com
NEXT_PUBLIC_DEFAULT_REGION=np
MEDUSA_SERVER_URL=http://backend:9000

# Publishable key — auto-generated on container startup and shared via volume.
# Override here only if you want to set a fixed publishable key manually.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ==============================================================================
# 4. CLOUD MEDIA STORAGE (Cloudinary)
# ==============================================================================
# Get these free from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# 5. TRANSACTIONAL EMAILS (Resend)
# ==============================================================================
# Get this free from https://resend.com (3,000 free emails/month)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@sasabysakshi.com

# ==============================================================================
# 6. SOCIAL MEDIA & WHATSAPP INTEGRATIONS
# ==============================================================================
# Phone number format: Country code without '+' or spaces (e.g. 9779800000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=9779800000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sasabysakshi
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@sasabysakshi
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sasabysakshi

# ==============================================================================
# 7. MARKETING & CONVERSION TRACKING PIXELS (Optional)
# ==============================================================================
# For Instagram & Facebook ad tracking
NEXT_PUBLIC_META_PIXEL_ID=
# For TikTok ad tracking
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ==============================================================================
# 8. AUTONOMOUS AI WHATSAPP SALES AGENT (Optional)
# ==============================================================================
# Connect to OpenAI, Groq, or Gemini to enable 24/7 AI WhatsApp customer sales
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Meta WhatsApp Cloud API credentials (from https://developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=sasabysakshi_verify_token

# ==============================================================================
# 9. GOOGLE OAUTH LOGIN (Optional)
# ==============================================================================
# From https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://sasabysakshi.com/auth/google/callback

# ==============================================================================
# 10. NEPALI PAYMENT GATEWAYS (eSewa / Khalti)
# ==============================================================================
# eSewa ePay v2 (Use 'false' for production merchant credentials)
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_TEST_MODE=true

# Khalti KPG-2 (Live Secret Key from https://admin.khalti.com)
KHALTI_SECRET_KEY=live_secret_key_68622e030cdd42129e92b3438a0f9b6b
KHALTI_TEST_MODE=true
