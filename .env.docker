# =================================================
# Docker Environment Variables
# Used by docker-compose.yml
# =================================================

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medusa-dtc-starter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- Medusa Backend -----
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-dtc-starter
DB_NAME=medusa-dtc-starter
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# CORS — allow storefront and admin
STORE_CORS=http://localhost:8000,http://storefront:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://backend:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://backend:9000,https://docs.medusajs.com

# Admin user auto-created by entrypoint
MEDUSA_ADMIN_EMAIL=admin@medusa.local
MEDUSA_ADMIN_PASSWORD=supersecret

NODE_ENV=production

# ----- Storefront -----
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9001
NEXT_PUBLIC_DEFAULT_REGION=dk
NEXT_PUBLIC_BASE_URL=http://localhost:8001

# Publishable key — auto-generated by backend entrypoint and written to shared volume.
# Set this manually here ONLY if you want to override the auto-generated key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
