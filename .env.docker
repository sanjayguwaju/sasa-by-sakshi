# =================================================
# Docker Environment Variables
# Used by docker-compose.yml
# =================================================

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sasa_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_URL=redis://redis:6379

# ----- Medusa Backend -----
DATABASE_URL=postgres://postgres:postgres@postgres:5432/sasa_db
DB_NAME=sasa_db
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# CORS — allow storefront and admin
STORE_CORS=http://localhost:8000,http://localhost:8001,http://storefront:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://backend:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://backend:9000,https://docs.medusajs.com

# Admin user auto-created by entrypoint
MEDUSA_ADMIN_EMAIL=admin@medusa.local
MEDUSA_ADMIN_PASSWORD=supersecret

NODE_ENV=development

# ----- Storefront -----
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=dk
NEXT_PUBLIC_BASE_URL=http://localhost:8001

# Publishable key — auto-generated by backend entrypoint and written to shared volume.
# Set this manually here ONLY if you want to override the auto-generated key.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ----- Cloudinary Storage -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Resend Email -----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ----- Social Media & WhatsApp Integrations -----
# Add your numbers and URLs here. If left blank, defaults or hidden gracefully.
NEXT_PUBLIC_WHATSAPP_NUMBER=9779800000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sasabysakshi
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@sasabysakshi
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sasabysakshi

# ----- Marketing & Analytics Pixels (Optional) -----
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ----- Autonomous AI WhatsApp Sales Agent (Optional) -----
# Connect to OpenAI, Groq, or Gemini to enable 24/7 AI WhatsApp customer sales
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Meta WhatsApp Cloud API credentials
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=sasabysakshi_verify_token

# ----- Google OAuth Login (Optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=


